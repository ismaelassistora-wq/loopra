      "id": "get-approved-posts",
      "name": "📋 Buscar Posts APPROVED de Hoy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extraer los posts del nodo anterior (n8n los pasa como múltiples items)\nconst posts = items.map(item => item.json);\n\nif (posts.length === 0) return [];\n\n// Usar DateTime de Luxon (incluido en n8n) para zona horaria correcta\nconst now = DateTime.now().setZone('Europe/Madrid');\nconst currentHour = now.hour;\nconst currentMinute = now.minute;\n\n// Publicar si la hora del post es la hora actual o ha pasado en los últimos 59 min\nconst toPublish = posts.filter(post => {\n  if (!post.proposed_time) return false;\n  const [h, m] = post.proposed_time.split(':').map(Number);\n  const postMinutes = h * 60 + m;\n  const nowMinutes = currentHour * 60 + currentMinute;\n  // Ventana de publicación: entre 0 y 59 minutos después de la hora del post\n  return nowMinutes >= postMinutes && nowMinutes < postMinutes + 60;\n});\n\nconsole.log(`Posts aprobados para hoy: ${posts.length}, a publicar ahora: ${toPublish.length}`);\n\nreturn toPublish.map(p => ({ json: p }));"
      },
      "id": "filter-by-time",
      "name": "🕐 Filtrar Por Hora Actual",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.image_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "media_binary"
            }
          }
        }
      },
      "id": "download-media",
      "name": "⬇️ Descargar Media",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 300]
    },
    {
      "parameters": {
        "jsCode": "// Preparar el caption completo: copy_text + hashtags\nconst post = $('🕐 Filtrar Por Hora Actual').item.json;\nconst binaryData = $('⬇️ Descargar Media').item.binary;\n\nconst hashtags = (post.hashtags || []).join(' ');\nconst caption = post.copy_text + (hashtags ? '\\n\\n' + hashtags : '');\n\n// Obtener el perfil de Upload-Post del cliente (o usar el default si falla)\nconst uploadProfile = (post.clients && post.clients.upload_post_profile) ? post.clients.upload_post_profile : 'prueba11';\n\nconsole.log(`Publicando post ID: ${post.id}, content_type: ${post.content_type}`);\n\nreturn [{\n  json: {\n    ...post,\n    caption,\n    uploadProfile,\n    isReel: post.content_type === 'REEL',\n    isStory: post.content_type === 'HISTORIA'\n  },\n  binary: binaryData\n}];"
      },
      "id": "prepare-upload",
      "name": "🔧 Preparar Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.content_type }}",
              "value2": "REEL"
            }
          ]
        }
      },
