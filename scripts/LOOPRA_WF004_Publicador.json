      "id": "upload-post",
      "name": "🖼️ Publicar POST",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 500]
    },
    {
      "parameters": {
        "jsCode": "// Verificar si la publicación fue exitosa\n// Puede llegar de cualquiera de las 3 ramas (REEL, HISTORIA, POST)\nconst response = items[0].json;\n\n// Recuperar el postId de la rama correspondiente\nlet postId = null;\ntry {\n  postId = $('🎬 Publicar REEL').item.json.id || null;\n} catch(e) {}\ntry {\n  if (!postId) postId = $('📖 Publicar HISTORIA').item.json.id || null;\n} catch(e) {}\ntry {\n  if (!postId) postId = $('🖼️ Publicar POST').item.json.id || null;\n} catch(e) {}\n\n// Si no podemos recuperarlo de la rama, intentar desde el payload preparado\nif (!postId) {\n  try { postId = $('🔧 Preparar Payload').item.json.id; } catch(e) {}\n}\n\nconst success = response.success === true;\n\nconsole.log(`Upload-Post response para post ${postId}:`, JSON.stringify(response));\n\nreturn [{\n  json: {\n    postId,\n    success,\n    requestId: response.request_id || null,\n    newStatus: success ? 'PUBLISHED' : 'FAILED',\n    publishedAt: new Date().toISOString(),\n    uploadPostResponse: response\n  }\n}];"
      },
      "id": "check-response",
      "name": "✅ Verificar Respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1600, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://vtlxfpthqpqkgfdiqqwn.supabase.co/rest/v1/posts?id=eq.{{ $json.postId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ0bHhmcHRocXBxa2dmZGlxcXduIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3Njk1MDAzOSwiZXhwIjoyMDkyNTI2MDM5fQ.sxhn5r7vi4_1x_kWCCdM4Bg4m4I7_w9fgr1ejphD-n8" },
            { "name": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ0bHhmcHRocXBxa2dmZGlxcXduIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3Njk1MDAzOSwiZXhwIjoyMDkyNTI2MDM5fQ.sxhn5r7vi4_1x_kWCCdM4Bg4m4I7_w9fgr1ejphD-n8" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: $json.newStatus, published_at: $json.publishedAt, published_urls: { upload_post_request_id: $json.requestId } }) }}",
        "options": {}
      },
