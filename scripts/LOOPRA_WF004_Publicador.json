          "parameters": [
            { "name": "status", "value": "eq.APPROVED" },
            { "name": "proposed_date", "value": "=eq.{{ $now.setZone('Europe/Madrid').toFormat('yyyy-MM-dd') }}" },
            { "name": "select", "value": "id,client_id,content_type,copy_text,hashtags,platform,image_url,proposed_date,proposed_time,clients(upload_post_profile)" },
